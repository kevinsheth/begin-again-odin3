#!/usr/bin/env bash
# Create a Mod Organizer profile for Begin Again from a preset in presets/.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
touch_mod="Odin Touchscreen Fix"
ao_mod="Odin Ambient Occlusion Off"

usage() {
    cat <<EOF
Usage: $(basename "$0") list
       $(basename "$0") apply PRESET [--mo2 DIR] [--from PROFILE] [--name PROFILE] [--keep-selection]

Copies a Mod Organizer profile, applies PRESET's graphics settings and selects
the new profile. Close the game and Mod Organizer first.

  --mo2 DIR         Mod Organizer folder containing ModOrganizer.ini
                    (default: the only one found under ~/Games)
  --from PROFILE    profile to copy (default: the selected profile)
  --name PROFILE    new profile name (default: "Odin <Preset>")
  --keep-selection  don't make the new profile the selected one
EOF
}

die() {
    echo "$(basename "$0"): $*" >&2
    exit 1
}

list_presets() {
    local file
    for file in "$repo"/presets/*.ini; do
        printf '%-12s %s\n' "$(basename "$file" .ini)" "$(sed -n '1s/^; //p' "$file")"
    done
}

# Set each [section] key from the preset in an INI file. Keys are matched
# case-insensitively, every duplicate is updated, missing keys are added to
# the end of their section and line endings are preserved.
apply_ini() {
    local preset=$1 target=$2 tmp
    tmp=$(mktemp "$target.XXXXXX")
    awk '
        function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
        function section_of(line) { return tolower(trim(substr(line, 2, index(line, "]") - 2))) }
        FNR == 1 { section = "" }
        {
            line = $0
            cr = sub(/\r$/, "", line)
        }
        NR == FNR {
            if (line ~ /^[ \t]*[;#]/ || trim(line) == "") next
            if (line ~ /^[ \t]*\[/) {
                section = section_of(trim(line))
                header[section] = substr(trim(line), 2, index(trim(line), "]") - 2)
                next
            }
            eq = index(line, "=")
            if (!eq || section == "odin") next
            key = trim(substr(line, 1, eq - 1))
            id = section SUBSEP tolower(key)
            if (!(id in value)) { order[++count] = id; display[id] = key; owner[id] = section }
            value[id] = trim(substr(line, eq + 1))
            next
        }
        {
            lines[++n] = line
            if (n == 1) eol = cr ? "\r" : ""
            if (line ~ /^[ \t]*\[/) {
                section = section_of(trim(line))
                last[section] = n
                seen[section] = 1
                next
            }
            eq = index(line, "=")
            if (eq && line !~ /^[ \t]*[;#]/) {
                id = section SUBSEP tolower(trim(substr(line, 1, eq - 1)))
                if (id in value) {
                    rest = substr(line, eq + 1)
                    match(rest, /^[ \t]*/)
                    lines[n] = substr(line, 1, eq) substr(rest, 1, RLENGTH) value[id]
                    done[id] = 1
                }
                last[section] = n
            }
        }
        END {
            for (i = 1; i <= count; i++) {
                id = order[i]
                if (id in done) continue
                entry = display[id] "=" value[id]
                if (owner[id] in seen) after[last[owner[id]]] = after[last[owner[id]]] entry eol "\n"
                else {
                    if (!(owner[id] in added)) { added[owner[id]] = 1; tail = tail eol "\n[" header[owner[id]] "]" eol "\n" }
                    tail = tail entry eol "\n"
                }
            }
            for (i = 1; i <= n; i++) printf "%s%s\n%s", lines[i], eol, after[i]
            printf "%s", tail
        }
    ' "$preset" "$target" > "$tmp"
    mv "$tmp" "$target"
}

preset_value() {
    awk -F= -v key="$2" '
        { sub(/\r$/, "") }
        /^\[/ { odin = tolower($0) == "[odin]"; next }
        odin && $1 == key { print $2; exit }
    ' "$1"
}

# Prints the highest-priority enabled mod's copy of a file.
winning_file() {
    local mo2=$1 profile=$2 relative=$3 mod
    while IFS= read -r mod; do
        mod=${mod%$'\r'}
        [[ $mod == +* ]] || continue
        mod=${mod#+}
        [[ $mod == "$touch_mod" || $mod == "$ao_mod" ]] && continue
        if [[ -f "$mo2/mods/$mod/$relative" ]]; then
            echo "$mo2/mods/$mod/$relative"
            return
        fi
    done < "$mo2/profiles/$profile/modlist.txt"
}

# Writes a small MO2 mod holding a copy of one mod's INI with some keys
# changed, then enables it at the highest priority in the profile.
override_mod() {
    local mo2=$1 profile=$2 mod=$3 ini=$4 settings=$5 source
    source=$(winning_file "$mo2" "$profile" "NVSE/Plugins/$ini")
    [[ -n $source ]] || die "no enabled mod provides $ini"
    mkdir -p "$mo2/mods/$mod/NVSE/Plugins"
    cp "$source" "$mo2/mods/$mod/NVSE/Plugins/$ini"
    printf '%b' "$settings" > "$mo2/mods/$mod/settings.tmp"
    apply_ini "$mo2/mods/$mod/settings.tmp" "$mo2/mods/$mod/NVSE/Plugins/$ini"
    rm "$mo2/mods/$mod/settings.tmp"

    local modlist="$mo2/profiles/$profile/modlist.txt" tmp
    tmp=$(mktemp "$modlist.XXXXXX")
    awk -v mod="$mod" '
        { line = $0; sub(/\r$/, "", line) }
        line == "+" mod || line == "-" mod { next }
        !inserted && line !~ /^#/ { print "+" mod (/\r$/ ? "\r" : ""); inserted = 1 }
        { print }
        END { if (!inserted) print "+" mod }
    ' "$modlist" > "$tmp"
    mv "$tmp" "$modlist"
}

find_mo2() {
    local found
    mapfile -t found < <(find "$HOME/Games" -maxdepth 3 -name ModOrganizer.ini -printf '%h\n' 2>/dev/null)
    [[ ${#found[@]} -eq 1 ]] || die "found ${#found[@]} Mod Organizer folders under ~/Games; pass --mo2 DIR"
    echo "${found[0]}"
}

apply_preset() {
    local preset_name=$1 mo2="" from="" name="" select=1
    shift
    while [[ $# -gt 0 ]]; do
        case $1 in
            --mo2) mo2=${2:?}; shift 2 ;;
            --from) from=${2:?}; shift 2 ;;
            --name) name=${2:?}; shift 2 ;;
            --keep-selection) select=0; shift ;;
            *) usage >&2; exit 2 ;;
        esac
    done

    local preset="$repo/presets/$preset_name.ini"
    [[ -f $preset ]] || die "unknown preset '$preset_name'; run '$(basename "$0") list'"
    [[ -n $mo2 ]] || mo2=$(find_mo2)
    [[ -f "$mo2/ModOrganizer.ini" ]] || die "no ModOrganizer.ini in $mo2"
    if pgrep -f 'FalloutNV\.exe|ModOrganizer\.exe' > /dev/null; then
        die "close the game and Mod Organizer first"
    fi

    if [[ -z $from ]]; then
        from=$(sed -n 's/^selected_profile=@ByteArray(\(.*\))\r\?$/\1/p' "$mo2/ModOrganizer.ini")
    fi
    [[ -d "$mo2/profiles/$from" ]] || die "profile '$from' not found"
    [[ -n $name ]] || name="Odin ${preset_name^}"
    [[ $name != "$from" ]] || die "pass --from with a different profile to rebuild '$name'"
    [[ ! -e "$mo2/profiles/$name" ]] || die "profile '$name' already exists; delete it in Mod Organizer or pass --name"

    local profile="$mo2/profiles/$name" file
    cp -a "$mo2/profiles/$from" "$profile"
    for file in falloutprefs.ini falloutcustom.ini; do
        [[ -f "$profile/$file" ]] && apply_ini "$preset" "$profile/$file"
    done
    printf '[General]\nLocalSettings=true\n' > "$profile/.local-settings"
    apply_ini "$profile/.local-settings" "$profile/settings.ini"
    rm "$profile/.local-settings"

    override_mod "$mo2" "$name" "$touch_mod" nvse_stewie_tweaks.ini '[Tweaks]\nbToggleControllerIfAttackPressed=0\n'
    if [[ $(preset_value "$preset" AmbientOcclusion) == 0 ]]; then
        override_mod "$mo2" "$name" "$ao_mod" VanillaPlusAO.ini '[Exterior]\nbEnabled=0\n[Interior]\nbEnabled=0\n'
    else
        sed -i "s/^+$ao_mod\(\r\?\)$/-$ao_mod\1/" "$profile/modlist.txt"
    fi

    if [[ $select -eq 1 ]]; then
        sed -i "s/^selected_profile=[^\r]*/selected_profile=@ByteArray($(printf '%s' "$name" | sed 's/[&/\]/\\&/g'))/" "$mo2/ModOrganizer.ini"
    fi
    echo "Created profile '$name' from '$from' with the $preset_name preset."
    if [[ $select -eq 1 ]]; then
        echo "It is selected; start the game from Steam as usual."
    fi
}

case ${1:-} in
    list) list_presets ;;
    apply) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; shift; apply_preset "$@" ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
